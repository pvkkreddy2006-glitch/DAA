#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    vector<int> coins = {1, 5, 6, 9};
    int amount = 11;

    vector<int> dp(amount + 1, 999);
    dp[0] = 0;

    for (int i = 1; i <= amount; i++) {
        for (int coin : coins) {
            if (coin <= i) {
                dp[i] = min(dp[i], dp[i - coin] + 1);
            }
        }
    }

    cout << "Coins: 1 5 6 9" << endl;
    cout << "Amount: " << amount << endl;
    cout << "Minimum number of coins: " << dp[amount] << endl;

    return 0;
}
